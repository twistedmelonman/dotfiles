# Default: ignore everything (safety net — new dirs are NOT auto-tracked)
/*

# ── Tracked directories ──────────────────────────────────
!bash/
!btop/
!dig/
!finicky/
!git/
!markdownlint-cli/
!pre-commit/
!shellcheck/
!tidy/
!vim/
!yamllint/
!yt-dlp/
!zizmor/
!s/
!gh/
!docs/
# CI workflows. Previously tracked without an allow entry (added before the
# default-ignore rule), which meant a NEW workflow file was silently ignored.
!.github/
# Project-local pre-push extension (runs the bash test suite before push).
!.project-hooks/

# Within gh/, only track preferences (not auth)
gh/*
!gh/config.yml
!gh/.gitignore

# ── Root files ────────────────────────────────────────────
!.gitignore
# Declares this repo's shell style so lint-shell.sh formats from a stated
# preference rather than a hook default (smartwatermelon/dotfiles#290).
!.editorconfig
# Repo-root shellcheck config for CI: resolves sourced files so standards-check
# does not fail on info-level SC1091. Distinct from shellcheck/.shellcheckrc,
# which is deployed to ~/.shellcheckrc for interactive use.
!.shellcheckrc
!README.md
!liquidpromptrc
!install.sh
!Brewfile

# ── Global exclusions (belt-and-suspenders) ───────────────
**/.claude/
**/*.key
**/*.pem
**/*.p12
**/secrets.*
**/credentials.*
**/.env
**/.env.*
**/*.jsonl
