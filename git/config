# This is Git's per-user configuration file.
# https://blog.gitbutler.com/how-git-core-devs-configure-git/
[user]
	# Account id 676392 is the personal account, renamed smartwatermelon ->
	# twistedmelonman in the 2026-09 org migration. GitHub resolves the noreply
	# address by id, so the old slug still attributed correctly — but
	# "smartwatermelon" is now a different entity (the org, id 325018381), so
	# the old form asserted something false. Keep this in sync with the account
	# name, not the org.
	email = 676392+twistedmelonman@users.noreply.github.com
	name = Andrew Rich
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[init]
	defaultBranch = main
	templateDir = ~/.config/git/template
[diff]
	# Custom prefixes for better diff readability (SRC/DST instead of a/b)
	srcPrefix = "SRC "
	dstPrefix = "DST "
	# Histogram algorithm: better rename detection than Myers
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[push]
	default = simple
	autoSetupRemote = true
	followTags = true
[fetch]
	prune = true       # Remove stale remote-tracking branches
	pruneTags = true   # Remove stale tags
	all = true         # Fetch from all remotes (not just origin)
[help]
	autocorrect = 20
[commit]
	verbose = true
[rerere]
	enabled = true
	autoupdate = true
[core]
	excludesfile = ~/.config/git/gitignore_global
	# Performance optimizations
	fsmonitor = true          # File system monitor for large repos
	untrackedCache = true      # Cache untracked files list
	hooksPath = ~/.config/git/hooks
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[merge]
	conflictstyle = zdiff3
[pull]
	rebase = true
# Literal path required: git config has no variable interpolation, so this
# cannot reference ${BEACON_WORKDIR} (bash/env.sh). Keep in sync by hand.
[includeIf "gitdir:~/Developer/beacon-biosignals/"]
	path = ~/.gitconfig-beacon
[review]
	preMergeTimeout = 420
